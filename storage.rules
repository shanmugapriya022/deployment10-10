rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // UI Testing screenshots and media assets
    match /ui_testing/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
